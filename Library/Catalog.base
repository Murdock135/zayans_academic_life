filters:
  and:
    - file.inFolder("Library/Items")
    - file.ext == "md"
views:
  - type: table
    name: All
    order:
      - file.name
      - authors
      - kind
      - status
      - progress
      - topics
      - url
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
      - property: progress
        direction: DESC
  - type: table
    name: Reading
    filters:
      and:
        - list(status).contains("reading")
    order:
      - file.name
      - authors
      - kind
      - status
      - progress
      - topics
      - url
    sort:
      - property: status
        direction: DESC
  - type: table
    name: Finished
    filters:
      and:
        - list(status).contains("finished")
    order:
      - file.name
      - authors
      - kind
      - status
      - progress
      - topics
      - url
      - finished_on
    sort:
      - property: finished_on
        direction: DESC
